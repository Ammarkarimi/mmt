{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@electric-sql/pglite/dist/**"
    }
  },
  "crons": [{ "path": "/api/cron/expire-holds", "schedule": "30 3 * * *" }]
}
